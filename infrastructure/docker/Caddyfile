# Reverse proxy for production (docker-compose.prod.yml). Caddy gets TLS
# certificates from Let's Encrypt automatically for every domain listed
# below — no cert files, no renewal cron, nothing to configure beyond DNS
# actually pointing at this host and ports 80/443 being reachable. This
# is the one piece docker-compose.yml (local) doesn't need: on localhost
# there's no real domain to issue a certificate for, so that file exposes
# each app's port directly instead.
#
# Each block proxies to a container by its Docker Compose service name —
# Docker's internal DNS resolves that to the right container, so this
# file never needs an IP address.

onenexora.com, www.onenexora.com {
	reverse_proxy website:3000
}

account.onenexora.com {
	reverse_proxy account:3001
}

console.onenexora.com {
	reverse_proxy console:3002
}

status.onenexora.com {
	reverse_proxy status:3003
}

api.onenexora.com {
	reverse_proxy api:3004
}

docs.onenexora.com {
	reverse_proxy docs:3005
}

developers.onenexora.com {
	reverse_proxy developers:3006
}

sentinel.onenexora.com {
	reverse_proxy sentinel:3007
}

cspm.onenexora.com {
	reverse_proxy cspm:3008
}

gateway.onenexora.com {
	reverse_proxy gateway:3009
}
