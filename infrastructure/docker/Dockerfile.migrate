# syntax=docker/dockerfile:1
#
# Runs packages/database's migrations against DATABASE_URL, then exits.
# Used once by docker-compose.yml (db-migrate service) before any app that
# needs Postgres starts. Not multi-stage — this doesn't need to be small
# or long-running, just correct, and it never ships as a running service.

FROM node:22-alpine
WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci

WORKDIR /repo/packages/database
CMD ["npm", "run", "db:migrate"]
