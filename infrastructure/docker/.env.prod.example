# Copy to infrastructure/docker/.env.prod and fill in real values. Never
# commit .env.prod itself (see .gitignore). Used two ways by
# docker-compose.prod.yml: as the --env-file for ${...} substitution
# (build args, the Postgres password) and as each app's own env_file (the
# runtime secrets each one actually reads) — same file, both jobs, which
# is why every var below is listed once even though not every app uses
# every one.

# Postgres — bundled in docker-compose.prod.yml. Pick a real password;
# this isn't a placeholder that degrades gracefully like the others below,
# Postgres won't start without it.
POSTGRES_PASSWORD=

# Clerk (https://dashboard.clerk.com/~/api-keys) — same instance across
# every app. The publishable key is also passed as a build arg (see
# docker-compose.prod.yml) since Next.js inlines NEXT_PUBLIC_* at build
# time, not runtime — set it here regardless, both uses read this line.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint pointed at
# https://api.<domain>/v1/webhooks/clerk (events: organization.deleted,
# user.deleted) — it deletes a closed organisation's data.
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe (https://dashboard.stripe.com) — see the root README's "Before
# this goes live" for which app needs which of these and why.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The "NEXORA Pro" product's two recurring prices: $29/month and $290/year.
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_YEARLY=
# Optional Customer Portal configuration (bpc_...) behind Billing's
# "Manage or cancel"; Stripe's default configuration is used when unset.
STRIPE_PORTAL_CONFIGURATION_ID=
