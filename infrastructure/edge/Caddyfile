# Unified reverse proxy for the shared instance hosting both NEXORA and
# Vigilo. This is the ONLY process bound to 80/443 on the host — each
# project's own docker-compose file starts its app containers but not a
# caddy service, since only one process can hold those ports. This
# container joins both projects' internal networks (nexora_default,
# vigilo-self-host_default) so it can reach containers in either stack
# while the two stacks stay otherwise fully isolated from each other
# (separate networks, separate Postgres, no cross-project traffic besides
# this).
#
# Targets use each container's full name (e.g. nexora-api-1), not its
# short service name (e.g. api) — both NEXORA and Vigilo have a service
# literally named "api", and Docker's embedded DNS resolution for a short
# name is ambiguous/undefined when the querying container (this one) is
# attached to both projects' networks at once. Full container names are
# globally unique on the host, so there's no ambiguity.

# Per-request metrics (request counts and latency by status code), served
# on a dedicated internal-only port rather than Caddy's admin API — that
# API can rewrite the running config, so it must stay on localhost. :9180
# is not published in docker-compose.yml; only Prometheus (same
# nexora_default network) scrapes it, as job "caddy". The Control Center
# and the Grafana alert read the 5xx rate from there.
{
	servers {
		metrics
	}
}

http://:9180 {
	metrics
}

# Apps with no Next.js Server Actions reject any request carrying the
# Server Action header. Internet-wide scanners send it to probe for the
# React Server Components RCE (CVE-2025-55182); the apps are patched, but
# each probe otherwise reaches Next.js and is logged as an error. Only
# import this into sites whose code has no "use server" — console,
# sentinel, cspm, gateway and vigilo use Server Actions and must not get it.
(no_server_actions) {
	@server_action header Next-Action *
	respond @server_action 403
}

# Baseline response headers for NEXORA's own apps (not Vigilo, NeuraWall or
# Grafana, which are separate products with their own needs). No
# includeSubDomains/preload on HSTS and no CSP yet: a CSP needs testing against
# Clerk and Stripe before it can be enforced. X-Frame-Options DENY: none of
# these apps is meant to be framed (console's billing and API-key pages are the
# clickjacking targets).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-X-Powered-By
		-Server
	}
}

# One canonical host: www redirects to the apex, keeping the path and query.
www.onenexora.com {
	redir https://onenexora.com{uri} permanent
}

onenexora.com {
	import security_headers
	import no_server_actions
	reverse_proxy nexora-website-1:3000
}

account.onenexora.com {
	import security_headers
	import no_server_actions
	reverse_proxy nexora-account-1:3001
}

console.onenexora.com {
	import security_headers
	# The Notification Hub's machine endpoints are for the compose network only (Grafana, the
	# host's cron). They check a bearer token themselves; this keeps them off the internet too.
	@internal path /api/internal/*
	respond @internal 404
	reverse_proxy nexora-console-1:3002
}

status.onenexora.com {
	import security_headers
	import no_server_actions
	reverse_proxy nexora-status-1:3003
}

api.onenexora.com {
	import security_headers
	import no_server_actions
	reverse_proxy nexora-api-1:3004
}

docs.onenexora.com {
	import security_headers
	import no_server_actions
	reverse_proxy nexora-docs-1:3005
}

developers.onenexora.com {
	import security_headers
	import no_server_actions
	reverse_proxy nexora-developers-1:3006
}

sentinel.onenexora.com {
	import security_headers
	reverse_proxy nexora-sentinel-1:3007
}
# Linegist (the product that used to be served as "sentinel"): its own Compose project in ~/linegist, reached by its full
# container name like everything else here. It uses Server Actions, so it gets security_headers but NOT no_server_actions.
# Samples can be up to 4 MB, so allow a little more than that for multipart overhead.
linegist.onenexora.com {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	reverse_proxy linegist-app-1:3000
}

# NEXORA CSPM is now a standalone product (github.com/xsmartbartx/AI-Driven-CSPM, deployed from ~/cspm-deploy as compose
# project "cspm"). One web container serves the site, the dashboard and the API by Host. It sets its own security headers
# and CSP, so security_headers is not imported. The previous app (apps/cspm, container nexora-cspm-1) is no longer routed.
cspm.onenexora.com, app.cspm.onenexora.com, api.cspm.onenexora.com {
	reverse_proxy cspm-web-1:80
}

# The NEXORA Gateway is the standalone product (xsmartbartx/Secure_AI_API_Gateway, /opt/gateway), its own compose project that
# this container joins. gateway-next.* is kept as an alias. The previous monorepo app (apps/gateway, container
# nexora-gateway-1) is still running but no longer routed; to roll back, point gateway.onenexora.com at
# nexora-gateway-1:3009 again and `deploy.sh edge`.
gateway.onenexora.com, gateway-next.onenexora.com {
	import security_headers
	reverse_proxy gateway-web-1:3000
}

gateway-next-api.onenexora.com {
	reverse_proxy gateway-api-1:8000
}

# OmniFlow (product #6) runs as its own compose project (~/omniflow on the host); this container joins its
# network below. It sets its own CSP and frame rules, so it does not import security_headers.
omniflow.onenexora.com {
	reverse_proxy omniflow-omniflow-1:8080
}

# OmniFlow's product site (static; `docker compose --profile site up -d site` in ~/omniflow). The hostname is a
# placeholder until the product has its own domain. It sets its own CSP, so no security_headers import.
www.omniflow.onenexora.com {
	reverse_proxy omniflow-site-1:80
}

vigilo.onenexora.com {
	reverse_proxy vigilo-self-host-web-1:3000
}

vigilo-api.onenexora.com {
	reverse_proxy vigilo-self-host-api-1:8000
}

neurawall.onenexora.com {
	reverse_proxy neurawall-control-plane-1:8080
}

# NeuraWall's public demo: a separate, read-only instance with synthetic traffic (compose profile
# "demo" in the NeuraWall repo; deploy.sh neurawall demo). The DNS record must exist before this
# block is reloaded, or Caddy cannot get a certificate for it.
neurawall-demo.onenexora.com {
	reverse_proxy neurawall-demo-1:8080
}

monitoring.onenexora.com {
	reverse_proxy nexora-grafana-1:3000
}
