          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products/sentinel",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products", "sentinel"]
            },
            "description": ""
          }
        },
        {
          "name": "GET /v1/products with a non-Bearer scheme",
          "event": [
            {
              "listen": "test",
