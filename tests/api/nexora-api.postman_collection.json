{
  "info": {
    "name": "NEXORA API",
    "description": "Contract tests for apps/api (https://api.onenexora.com). Real endpoints only. Run with `npm run test:api` or import into Postman / Insomnia. Folders 1 and 2 need no API key and no database; folders 3 and 4 need a database-backed stack, and folder 4 needs a real `apiKey`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Public",
      "item": [
        {
          "name": "GET /v1/health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('reports ok', function () { pm.expect(body.status).to.eql('ok'); });",
                  "pm.test('time is an ISO timestamp', function () { pm.expect(new Date(body.time).toISOString()).to.eql(body.time); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            },
            "description": "Unauthenticated on purpose."
          }
        }
      ]
    },
    {
      "name": "2. Auth rejection (no key, no database needed)",
      "item": [
        {
          "name": "GET /v1/products without a key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
                  "const body = pm.response.json();",
                  "pm.test('error contract: {error:{code,message,request_id}}', function () {",
                  "  pm.expect(body.error).to.be.an('object');",
                  "  pm.expect(body.error.code).to.be.a('string');",
                  "  pm.expect(body.error.message).to.be.a('string');",
                  "  pm.expect(body.error.request_id).to.match(/^[0-9a-f-]{36}$/);",
                  "});",
                  "pm.test('error code is missing_api_key', function () { pm.expect(body.error.code).to.eql('missing_api_key'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products"]
            },
            "description": ""
          }
        },
        {
          "name": "GET /v1/products/sentinel without a key",
          "event": [
