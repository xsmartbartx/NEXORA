# Clerk (https://dashboard.clerk.com/~/api-keys) — same instance across every app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres, for API keys, usage/audit events and entitlements.
DATABASE_URL=postgres://user:password@localhost:5432/nexora

# The one upstream provider Gateway proxies to today (apps/gateway/src/lib/relay.ts).
# Defaults to Anthropic's Messages API shape — point GATEWAY_UPSTREAM_URL
# elsewhere (including a local mock server) to use a different upstream.
GATEWAY_UPSTREAM_URL=https://api.anthropic.com/v1/messages
GATEWAY_UPSTREAM_API_KEY=

# Cross-app links — see apps/account/.env.example for the full set.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3002
NEXT_PUBLIC_STATUS_URL=http://localhost:3003
NEXT_PUBLIC_DOCS_URL=http://localhost:3005

NEXT_PUBLIC_NEXORA_ENV=development
