# Clerk (https://dashboard.clerk.com/~/api-keys) — same instance across every app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres, for API keys and audit events (packages/database). Any managed
# Postgres works — see packages/database/README for migrations.
DATABASE_URL=postgres://user:password@localhost:5432/nexora

# Stripe (https://dashboard.stripe.com/apikeys) — secret key, used
# server-side only to create Checkout Sessions; never sent to the browser.
# The "NEXORA Pro" monthly and yearly price ids — see
# packages/billing/src/plans.ts.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_YEARLY=
# Optional Customer Portal configuration (bpc_...) behind Billing's
# "Manage or cancel"; Stripe's default configuration is used when unset.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional Coupon ids (billing/actions.ts's startBundleCheckout) applied to
# a bundle checkout's combined price — see bundleDiscountPercent in
# packages/billing/src/plans.ts for the percentages these should match.
# A bundle still checks out fine without these set, just without a coupon.
STRIPE_COUPON_BUNDLE_2=
STRIPE_COUPON_BUNDLE_3=

# Cross-app links — see apps/account/.env.example for the same block.
# NEXT_PUBLIC_CONSOLE_URL here is this app's own URL: Stripe Checkout
# requires an absolute success/cancel URL to redirect back to.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3001
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3002
NEXT_PUBLIC_STATUS_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3004
NEXT_PUBLIC_DOCS_URL=http://localhost:3005
NEXT_PUBLIC_DEVELOPERS_URL=http://localhost:3006

NEXT_PUBLIC_NEXORA_ENV=development

# Sentry (packages/observability) — the DSN is meant to be public, not a
# secret, but stays unset in local dev so errors aren't reported from your
# own machine. https://nexora-ct.sentry.io/settings/projects/nexora-platform/keys/
NEXT_PUBLIC_SENTRY_DSN=

# NeuraWall is linked from /billing; it defaults to production and is optional.
NEXT_PUBLIC_NEURAWALL_URL=https://neurawall.onenexora.com
