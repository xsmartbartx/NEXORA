# Clerk (https://dashboard.clerk.com/~/api-keys) — same instance across every app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Postgres, for API keys and audit events (packages/database). Any managed
# Postgres works — see packages/database/README for migrations.
DATABASE_URL=postgres://user:password@localhost:5432/nexora

# Paddle (https://vendors.paddle.com/authentication) — client-side checkout
# token, safe to expose. TODO(launch): PADDLE_PRICE_ID_PRO is a placeholder
# plan — see packages/billing/src/plans.ts.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_PRO=

# Cross-app links — see apps/account/.env.example for the same block.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_ACCOUNT_URL=http://localhost:3001
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3002
NEXT_PUBLIC_STATUS_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3004
NEXT_PUBLIC_DOCS_URL=http://localhost:3005
NEXT_PUBLIC_DEVELOPERS_URL=http://localhost:3006

NEXT_PUBLIC_NEXORA_ENV=development
