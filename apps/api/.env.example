# Same Postgres as apps/console — API keys are verified against the same
# api_keys table Console writes to.
DATABASE_URL=postgres://user:password@localhost:5432/nexora

# Stripe (https://dashboard.stripe.com/webhooks) — webhook signing secret
# only; this app never calls Stripe's API to create anything, it just
# verifies and processes incoming subscription events.
# The "NEXORA Pro" monthly and yearly price ids — see
# packages/billing/src/plans.ts.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_YEARLY=

NEXT_PUBLIC_DOCS_URL=http://localhost:3005
