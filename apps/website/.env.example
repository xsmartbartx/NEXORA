# The canonical production URL, used for metadata, OG tags and the sitemap.
# Falls back to https://onenexora.com when unset — see src/lib/site-config.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cross-app links rendered in the header/footer.
NEXT_PUBLIC_DEVELOPERS_URL=http://localhost:3006
NEXT_PUBLIC_DOCS_URL=http://localhost:3005
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3002
NEXT_PUBLIC_STATUS_URL=http://localhost:3003

# Sentry (packages/observability) — the DSN is meant to be public, not a
# secret, but stays unset in local dev so errors aren't reported from your
# own machine. https://nexora-ct.sentry.io/settings/projects/nexora-platform/keys/
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_NEXORA_ENV=development
