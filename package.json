{
  "name": "nexora-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA — Build What's Next. Monorepo for the NEXORA platform: website, console, account, docs and shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/website",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
