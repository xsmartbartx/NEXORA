{
  "name": "nexora-platform",
  "version": "0.1.0",
  "private": true,
  "description": "NEXORA \u2014 Build What's Next. Monorepo for the NEXORA platform: website, console, account, docs and shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/website",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:api": "bash scripts/api-test.sh",
    "doctor": "bash scripts/doctor.sh",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "picomatch": "^4.0.7",
    "prettier": "^3.4.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
